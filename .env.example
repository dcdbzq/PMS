# Default local-account mode requires no external service credentials.
PMS_AUTH_MODE=local
PMS_HOST=127.0.0.1
PMS_PORT=8000
# Optional database path. Omit to use data/pms.sqlite3 under the project.
# PMS_DB=../pms-data/pms.sqlite3
# Optional upload path. Omit to use attachments/ beside the database.
# PMS_UPLOAD_DIR=../pms-data/attachments
# Set to 1 when accessed through an HTTPS reverse proxy; 0 for local HTTP.
PMS_SECURE_COOKIE=0

# Optional Feishu integration. Leave credentials empty in local mode.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://pms.example.com/api/auth/feishu/callback
# Open IDs from the same application; separate multiple IDs with commas.
FEISHU_ADMIN_OPEN_IDS=
FEISHU_TENANT_KEY=
FEISHU_SYNC_INTERVAL=900
